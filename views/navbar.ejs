<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="<%= JSON.parse(routes).root %>"><%= t('app.title') %></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t('nav.backups') %></a>
          <ul class="dropdown-menu">
            <% if (backups.length == 0){ %>
              <li><a class="dropdown-item" href="#"><%= t('nav.none') %></a></li>
            <% } else { %>
              <% backups.forEach(function(file){ %>
                <li><a class="dropdown-item" href="<%= JSON.parse(routes).restore %>?db=<%= file %>"><%= file %></a></li>
              <% }) %>
            <% } %>
          </ul>
        </li>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="https://github.com/alseambusher/crontab-ui"><%= t('nav.github') %></a></li>
      </ul>
    </div>
  </div>
</nav>
