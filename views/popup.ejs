<!-- Job -->
<div class="modal fade" id="job" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="job-title"><%= t('job.title') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="job-body">
	<label class="form-label"><%= t('job.name') %></label>
	<input type='text' class='form-control' id='job-name'/><br />
	<label class="form-label"><%= t('job.command') %></label>
	<textarea class='form-control' id='job-command' rows='3' oninput="job_command = $(this).val(); job_string();"></textarea><br />
	<label class="form-label"><%= t('job.quick_schedule') %></label><br />
	<div class="d-flex flex-wrap gap-2 mb-3">
		<a class="btn btn-primary btn-sm" onclick="schedule = '* * * * *'; job_string();"><%= t('job.every_minute') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '*/5 * * * *'; job_string();"><%= t('job.every_5min') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '@hourly'; job_string();"><%= t('job.hourly') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '@daily'; job_string();"><%= t('job.daily') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '@weekly'; job_string();"><%= t('job.weekly') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '@monthly'; job_string();"><%= t('job.monthly') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '@yearly'; job_string();"><%= t('job.yearly') %></a>
		<a class="btn btn-primary btn-sm" onclick="schedule = '@reboot'; job_string();"><%= t('job.startup') %></a>
	</div>

	<div class="row">
		<div class="col-md-2"><%= t('job.cron_minute') %></div>
		<div class="col-md-2"><%= t('job.cron_hour') %></div>
		<div class="col-md-2"><%= t('job.cron_day') %></div>
		<div class="col-md-2"><%= t('job.cron_month') %></div>
		<div class="col-md-2"><%= t('job.cron_week') %></div>
	</div>
	<div class="row">
		<div class="col-md-2"><input type="text" class="form-control" id="job-minute" value="*" onclick="this.select();"/></div>
		<div class="col-md-2"><input type="text" class="form-control" id="job-hour" value="*" onclick="this.select();"/></div>
		<div class="col-md-2"><input type="text" class="form-control" id="job-day" value="*" onclick="this.select();"/></div>
		<div class="col-md-2"><input type="text" class="form-control" id="job-month" value="*" onclick="this.select();"/></div>
		<div class="col-md-2"><input type="text" class="form-control" id="job-week" value="*" onclick="this.select();"/></div>
		<div class="col-md-2"><a class="btn btn-primary btn-sm" onclick="set_schedule();"><%= t('btn.set') %></a></div>
	</div>

	<br />
	<br />
	<label class="form-label"><%= t('job.job_string') %></label>
	<input type='text' class='form-control' id='job-string' disabled='disabled'/><br />
	<div class="form-check">
		<input type="checkbox" class="form-check-input" id="job-logging"/>
		<label class="form-check-label" for="job-logging"><%= t('job.enable_logging') %></label>
	</div>
	<br/>
	<a class="btn btn-primary btn-sm" data-json="{}" onclick="setMailConfig(this);" id="job-mailing"><%= t('btn.mailing') %></a>
	<a class="btn btn-primary btn-sm" data-json="{}" onclick="setHookConfig(this);"><%= t('btn.hooks') %></a>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('btn.cancel') %></button>
        <button type="button" class="btn btn-primary" id="job-save"><%= t('btn.save') %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-title"><%= t('popup.message') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="modal-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="modal-close-button"><%= t('btn.close') %></button>
        <button type="button" class="btn btn-primary" id="modal-button"><%= t('btn.ok') %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="info-popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="info-title"><%= t('popup.message') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="info-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="info-button"><%= t('btn.ok') %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="preview-crontab-modal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-code-square"></i> <%= t('preview.title') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3"><i class="bi bi-exclamation-triangle"></i> <%= t('preview.warning') %></div>
        <pre id="preview-crontab-content" class="bg-dark text-light p-3 rounded" style="min-height:200px;white-space:pre-wrap;word-break:break-all;font-size:0.875rem;"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="copyCrontab()"><i class="bi bi-clipboard"></i> <%= t('btn.copy') %></button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('btn.close') %></button>
      </div>
    </div>
  </div>
</div>
